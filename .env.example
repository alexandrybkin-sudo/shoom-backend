# Copy to .env on the server and fill in real values. NEVER commit .env.

# --- LiveKit server (self-hosted) ---
# Format: "APIxxxx: secret"  (note the space after the colon)
LIVEKIT_KEYS=APIxxxxxxxxxxxx: your_livekit_secret

# --- Backend (Express) talks to the LiveKit API over the internal Docker host ---
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_URL=http://host.docker.internal:7880
FRONTEND_URL=https://shoom.fun
PORT=3001

# --- Frontend build-time public vars (baked into the Next.js build) ---
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.shoom.fun
NEXT_PUBLIC_SOCKET_URL=https://shoom.fun
